# Application
PORT=8082

# Database
DATABASE_URL=app:app_password@tcp(localhost:3306)/app_db?parseTime=true

# MySQL Podman Configuration
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=app_db
MYSQL_USER=app
MYSQL_PASSWORD=app_password



JWT_SECRET=assignment-secret-change-me-at-least-32-bytes

# Browser origins trusted by CORS and cookie authentication
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
